{
  "name": "outfall-offline-review-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "污水处理厂排口污染负荷离线复核分析台（React + TypeScript + IndexedDB + WebWorker）",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:sample": "tsx scripts/generate-sample.ts",
    "generate:investigate": "tsx scripts/generate-investigate.ts",
    "verify:sample": "tsx scripts/verify-sample.ts",
    "verify:investigate": "tsx scripts/verify-investigate.ts",
    "start": "npm run build && vite preview --host 0.0.0.0 --port 4173",
    "serve": "vite preview --host 0.0.0.0 --port 4173",
    "verify": "tsc --noEmit && vitest run && tsx scripts/verify-sample.ts && tsx scripts/verify-investigate.ts"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
